# Copy to .env and fill in. Never commit the real .env file.

# --- application ---
ENVIRONMENT=development
DEBUG=true

# --- database ---
# Local PostgreSQL created by docker compose up db
DATABASE_URL=postgresql+psycopg://ou_user:change_me@localhost:5432/football_ou
DB_ECHO=false

# --- data provider ---
# football-data-uk | football-data | api-football
#
# football-data-uk is the default because it needs no account and no key, and
# it is the only free source here that carries real Over/Under 2.5 bookmaker
# prices. Without those the market comparison has nothing real to compare to.
DATA_PROVIDER=football-data-uk

# Public CSV archive, no key required.
FOOTBALL_DATA_UK_BASE_URL=https://www.football-data.co.uk

# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Key from https://www.api-football.com/ (api-sports.io)
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# football-data.co.uk division codes: E0, E1, SC0, D1, SP1, I1, F1, N1, P1
# football-data.org codes: PL, BL1, SA, PD, FL1, DED, PPL
# API-Football league ids: 39, 78, 135, 140, 61
COMPETITIONS=E0
SEASONS_BACK=2
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_SLEEP_SECONDS=6

# --- model ---
MODEL_LAST_N_MATCHES=20
MODEL_MAX_GOALS=6
# Dixon-Coles low-score correction. 0 disables it.
MODEL_RHO=-0.05
MODEL_LINES=1.5,2.5,3.5
# Pull team strengths toward the league average when the evidence is thin.
# auto derives the constant from the data, off uses the raw ratios, or give a
# number to set it directly. Walk-forward testing says leave this on auto.
MODEL_SHRINKAGE=auto

# --- google sheets via apps script (recommended, no Google Cloud needed) ---
# Paste apps-script/Code.gs into the sheet's Apps Script editor, deploy it as a
# web app, then put the /exec URL here. The token must match SECRET in that file.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# --- google sheets via service account (alternative) ---
# Needs a Google Cloud project. Share the sheet with the service account email
# as Editor, or every write returns 403. Keep the key file outside this repo.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- news ---
# Headlines are shown beside the analysis as reading context. They are never
# fed into the model, because there is no validated way to turn news text into
# expected goals.
NEWS_ENABLED=true
NEWS_CACHE_SECONDS=300

# --- api ---
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
